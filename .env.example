# Copy to .env.local for local development. Only this file is committed.

# Public origin of the app, without a path. Tag URLs and QR codes are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection of the app: the framed_app_login user (RLS applies). Local Docker value;
# start it with `pnpm db:up`. On Neon use the pooled endpoint of the app login user.
DATABASE_URL=postgres://framed_app_login:framed_app_login@localhost:5433/framed

# Postgres connection used only by migrations (drizzle-kit): the database owner. Local Docker
# value. Never set it on the running app.
MIGRATION_DATABASE_URL=postgres://framed_owner:framed_owner@localhost:5433/framed

# Postgres connection of Better Auth: the framed_auth_login user (privileges on auth tables only).
# Used by Better Auth, validated when it lands. Local Docker value.
AUTH_DATABASE_URL=postgres://framed_auth_login:framed_auth_login@localhost:5433/framed
